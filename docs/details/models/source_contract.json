{
  "comment": "端点默认值与 Graph 协议共享；sources/cache_policies/auto_fallback/cache_key/errors 保留为 Python 开发工具契约。产品前端无服务端请求，其来源规则见 frontend。",
  "frontend": {
    "sources": ["builtin", "hf", "config"],
    "legacy_auto_fallback": ["builtin", "hf"],
    "legacy_local": "choose-browser-directory"
  },
  "sources": ["auto", "builtin", "local", "hf", "config"],
  "cache_policies": ["prefer-local", "refresh", "offline"],
  "auto_fallback": ["builtin", "local", "hf"],
  "endpoints": {
    "huggingface": {
      "hub_url": "https://huggingface.co",
      "default_revision": "main"
    },
    "modelscope": {
      "hub_url": "https://www.modelscope.cn",
      "default_revision": "master"
    }
  },
  "cache_key": ["repo_id", "revision", "cache_dir"],
  "errors": {
    "config": 400,
    "not_found": 404,
    "remote": 502
  },
  "graph_protocol": {
    "schema_version": 2,
    "graph_fields": ["version", "schema_version", "root_id", "nodes", "edges"],
    "node_base_fields": [
      "id", "name", "type", "repeat", "attributes", "source_fields", "confidence",
      "params", "weight_shapes", "dtype", "input_shape", "output_shape",
      "value_source", "tensor_names"
    ],
    "graph_node_extra": ["canonical_id", "module_id", "parent_id", "order"],
    "edge_fields": ["id", "source", "target", "source_canonical_id", "target_canonical_id", "kind", "evidence"]
  }
}
